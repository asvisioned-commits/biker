# Supabase — Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Database Mode
# Set to 'false' to use local storage fallback (not recommended for production)
NEXT_PUBLIC_USE_LIVE_DB=true

# App
NEXT_PUBLIC_APP_NAME=Biker
NEXT_PUBLIC_APP_URL=https://your-app-url.vercel.app
